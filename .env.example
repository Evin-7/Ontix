# Copy this file to .env.local and replace both placeholders with connection strings
# from the same dedicated Neon development branch. Never commit real credentials.
# These settings configure the Neon and Better Auth workspace provider
# until the Foundry-only business-data replacement has passed end-to-end verification.
# DATABASE_URL uses the provided pooled endpoint (hostname includes "-pooler").
# Replace the password privately in ignored .env.local before connecting.
DATABASE_URL="postgresql://neondb_owner:REPLACE_WITH_PRIVATE_PASSWORD@ep-curly-sound-b4f5ukbq-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Obtain the matching direct URL from Neon Console; never derive it from the pooled URL.
DIRECT_DATABASE_URL="REPLACE_WITH_DIRECT_NEON_URL_FROM_CONSOLE"

DATA_PROVIDER="neon-demo"
DATABASE_ENVIRONMENT="development"
DATABASE_BRANCH_NAME="ontix-dev"
BETTER_AUTH_URL="http://127.0.0.1:3000"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-random-characters"

# Optional first-time operator bootstrap. Set only in private .env.local, run
# npm run db:bootstrap-admin once, then remove the password from .env.local.
BOOTSTRAP_ADMIN_NAME="Ontix Administrator"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_EMPLOYEE_NUMBER="OX-9000"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-password"

# Optional genuine Foundry public OAuth setup. Keep all tokens server-side.
# The public client has no client secret. Use the exact registered callback.
# Generate a private 32-byte encryption key for token-at-rest encryption.
FOUNDRY_STACK_URL="https://ontix.usw-23.palantirfoundry.com"
FOUNDRY_CLIENT_ID="REPLACE_WITH_DEVELOPER_CONSOLE_CLIENT_ID"
ONTIX_APPLICATION_URL="http://127.0.0.1:3000"
FOUNDRY_REDIRECT_URI="http://127.0.0.1:3000/api/foundry/oauth/callback"
FOUNDRY_TOKEN_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"
# The enrollment-generated SDK exports the Ontology RID; do not copy it into a public variable.

# Foundry-only sign-in session store. Use a non-global/region-bound Upstash database
# in the same region as the Next.js runtime. Do not put business records in this store.
UPSTASH_REDIS_REST_URL="https://REPLACE_WITH_UPSTASH_ENDPOINT.upstash.io"
UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_PRIVATE_UPSTASH_TOKEN"

# Comma-separated Foundry group IDs. Role assignment is default-deny; group IDs
# must be copied from Foundry and a group cannot map to multiple Ontix roles.
FOUNDRY_ADMIN_GROUP_IDS=""
FOUNDRY_MANAGER_GROUP_IDS=""
FOUNDRY_DEVELOPER_GROUP_IDS=""
FOUNDRY_ANALYST_GROUP_IDS=""

# Optional private, read-only workspace login. Generate a password and scrypt
# hash with `npm run workspace:credentials`; the password is written to a
# local 0600 file outside the repository. Never commit the hash or password.
ONTIX_WORKSPACE_USERNAME="ontix-workspace"
ONTIX_WORKSPACE_PASSWORD_HASH="scrypt-v1:16384:8:1:REPLACE_WITH_SALT:REPLACE_WITH_HASH"
