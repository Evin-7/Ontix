generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id          String    @id @default(cuid())
  name        String    @unique
  department  String
  description String    @default("")
  createdAt   DateTime  @default(now())
  employees   Employee[]
  projects    Project[]

  @@map("teams")
}

model Employee {
  id                 String            @id @default(cuid())
  employeeNumber     String            @unique
  name               String
  email              String            @unique
  title              String
  department         String
  role               String            @default("DEVELOPER")
  passwordHash       String
  isDemoAccount      Boolean           @default(false)
  isActive           Boolean           @default(true)
  teamId             String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  team               Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  ownedCustomers     Customer[]        @relation("CustomerOwner")
  assignedCases      OperationalCase[] @relation("CaseAssignee")
  projectAssignments ProjectAssignment[]
  submittedApprovals ApprovalRequest[] @relation("ApprovalRequester")
  reviewedApprovals  ApprovalRequest[] @relation("ApprovalReviewer")
  activityEvents     ActivityEvent[]   @relation("ActivityActor")
  sessions           Session[]
  authUser           AuthUser?

  @@index([teamId])
  @@index([role, isActive])
  @@map("employees")
}

// Better Auth identities are separate from Ontix employee records. Business
// relations continue to reference employees; this optional link maps a login
// identity to an employee for authorization and audit attribution.
model AuthUser {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  employeeId    String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  employee      Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sessions      AuthSession[]
  accounts      AuthAccount[]

  @@map("auth_users")
}

model AuthSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

model AuthRateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limits")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      Employee     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Customer {
  id          String            @id @default(cuid())
  customerKey String            @unique
  name        String
  industry    String
  email       String
  phone       String
  status      String            @default("ACTIVE")
  accountOwnerId String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  archivedAt  DateTime?
  accountOwner Employee?            @relation("CustomerOwner", fields: [accountOwnerId], references: [id], onDelete: SetNull)
  projects    Project[]
  cases       OperationalCase[]

  @@index([status, archivedAt])
  @@index([name])
  @@map("customers")
}

model Project {
  id          String             @id @default(cuid())
  projectKey  String             @unique
  name        String
  description String
  customerId  String
  teamId      String?
  status      String             @default("PLANNING")
  priority    String             @default("MEDIUM")
  startDate   DateTime
  dueDate     DateTime
  progress    Int                @default(0)
  revision    Int                @default(0)
  budget      Decimal            @default(0) @db.Decimal(12, 2)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  team        Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignments ProjectAssignment[]
  cases       OperationalCase[]

  @@index([customerId])
  @@index([teamId, status])
  @@index([dueDate])
  @@map("projects")
}

model ProjectAssignment {
  id         String   @id @default(cuid())
  projectId  String
  employeeId String
  assignedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([employeeId])
  @@map("project_assignments")
}

model OperationalCase {
  id                  String            @id @default(cuid())
  caseKey             String            @unique
  title               String
  description         String
  customerId          String
  projectId           String?
  assignedEmployeeId  String?
  priority            String            @default("MEDIUM")
  status              String            @default("OPEN")
  category            String
  slaDeadline         DateTime
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  revision            Int               @default(0)
  escalationLevel     Int               @default(0)
  resolutionDate      DateTime?
  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project             Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedEmployee    Employee?             @relation("CaseAssignee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  approvals           ApprovalRequest[]

  @@index([status, priority])
  @@index([assignedEmployeeId, status])
  @@index([customerId])
  @@index([projectId])
  @@index([slaDeadline, status])
  @@map("operational_cases")
}

model ApprovalRequest {
  id                String           @id @default(cuid())
  approvalKey       String           @unique
  type              String
  title             String
  justification     String
  amount            Decimal?          @db.Decimal(12, 2)
  status            String           @default("PENDING")
  caseId            String?
  requestedById     String
  reviewerId        String?
  reviewerComment   String            @default("")
  createdAt         DateTime          @default(now())
  decidedAt         DateTime?
  revision          Int               @default(0)
  case              OperationalCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  requestedBy       Employee             @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewer          Employee?            @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reviewerId, status])
  @@index([caseId])
  @@map("approval_requests")
}

model ActivityEvent {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  objectType  String
  objectId    String
  summary     String
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime @default(now())
  actor       Employee?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([objectType, objectId, createdAt])
  @@index([actorId, createdAt])
  @@map("activity_events")
}
